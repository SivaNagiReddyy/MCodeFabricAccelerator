	measure 'Total Sales' = SUM(fact_sales[NetAmount])
		lineageTag: 5049e632-367b-4782-85dc-5f5b629f5f3f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' = DISTINCTCOUNT(fact_sales[SalesOrderID])
